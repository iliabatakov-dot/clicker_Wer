.agrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(58px,1fr));gap:4px;margin-bottom:8px}
.ac{aspect-ratio:1;border-radius:7px;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:2px;background:rgba(120,150,255,.05);border:1px solid rgba(150,180,255,.12);opacity:.3;font-size:7px;transition:.2s}
