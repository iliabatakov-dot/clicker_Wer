function makeFCode(){
  const a=getAccs();const acc=a[curUser];if(!acc)return '';
  return 'CBF2|'+b64e({i:acc.id,n:curUser,c:Math.floor(S.clicks),
    b:Math.floor(S.balance),p:S.prestigeLevel||0,
    ac:Object.keys(S.achievements||{}).length,t:ts()});
}
function parseFCode(str){
  if(!str||!str.startsWith('CBF2|'))return null;
  const d=b64d(str.slice(5));
  if(!d||!d.i||!d.n)return null;
  return {id:String(d.i),name:String(d.n).slice(0,20),
    clicks:Math.max(0,Math.floor(d.c)||0),balance:Math.max(0,Math.floor(d.b)||0),
    prestige:Math.max(0,Math.floor(d.p)||0),ach:Math.max(0,Math.floor(d.ac)||0),
    ts:d.t||ts()};
}
