// Auto income
let lastTick=performance.now();
function loop(now){
  const dt=Math.min(now-lastTick,100)/1000;
  lastTick=now;
  if(curUser&&S.auto>0){
    const gain=S.auto*dt;
    S.clicks+=gain;S.balance+=gain;
  }
  requestAnimationFrame(loop);
}
requestAnimationFrame(loop);

setInterval(()=>{
  if(curUser){
    $('sBal').textContent=fmt(S.balance);
    $('sClk').textContent=fmt(S.clicks);
  }
},500);
setInterval(()=>{if(curUser)saveState();},5000);
setInterval(()=>{if(curUser)checkAch();},2000);
window.addEventListener('beforeunload',()=>{if(curUser)saveState();});

})();
