.sbox{padding:8px;border-radius:8px;text-align:center;background:rgba(167,139,250,.1);border:1px solid rgba(167,139,250,.25)}
.sbox .sl{font-size:9px;letter-spacing:.1em;opacity:.7;text-transform:uppercase;font-weight:800;margin-bottom:2px}
