    $('loginSubmit').textContent=loginMode==='login'?'ВОЙТИ':'СОЗДАТЬ';
  };
});
$('loginSubmit').onclick=()=>{
  const name=$('loginName').value.trim().slice(0,20),pass=$('loginPass').value;
  if(!name||name.length<2){$('loginErr').textContent='Имя: мин.2';return;}
  if(!pass||pass.length<3){$('loginErr').textContent='Пароль: мин.3';return;}
  const a=getAccs(),h=hp(pass);
  if(loginMode==='register'){
    if(a[name]){$('loginErr').textContent='Имя занято';return;}
    a[name]={id:gid(),pass:h,state:defState(),friends:{},created:ts()};
    saveAccs(a);enterGame(name);
  }else{
    if(!a[name]){$('loginErr').textContent='Не найден';return;}
    if(a[name].pass!==h){$('loginErr').textContent='Неверный пароль';return;}
    if(a[name].banned){$('loginErr').textContent='🚫 Забанен';return;}
    enterGame(name);
  }
};
$('loginGuest').onclick=()=>{
  const name='Гость_'+Math.random().toString(36).slice(2,6);
  const a=getAccs();
  a[name]={id:gid(),pass:'',state:defState(),friends:{},guest:true,created:ts()};
  saveAccs(a);enterGame(name);
};
$('loginReset').onclick=()=>{
  if(!confirm('Удалить всё?'))return;
  try{localStorage.removeItem(ACC_KEY);localStorage.removeItem(CUR_KEY);localStorage.removeItem(SESS_KEY);}catch(e){}
  location.reload();
};
$('loginName').onkeydown=e=>{if(e.key==='Enter')$('loginPass').focus();};
$('loginPass').onkeydown=e=>{if(e.key==='Enter')$('loginSubmit').click();};

function enterGame(name){
  curUser=name;setCur(name);makeSess(name);
  const a=getAccs();
  isAdmin=!!(a[name]&&a[name].isAdmin);
  S=Object.assign(defState(),a[name].state||{});
  if(!S.upgrades||typeof S.upgrades!=='object')S.upgrades={};
  if(!S.usedPromos)S.usedPromos=[];
  if(!S.achievements)S.achievements={};
  if(!S.ownedSkins||!S.ownedSkins.length)S.ownedSkins=['default'];
  if(!S.ownedSounds||!S.ownedSounds.length)S.ownedSounds=['boing'];
  if(!S.messages)S.messages=[];
  if(S.soundOn===undefined)S.soundOn=true;
  if(S.animationsOn===undefined)S.animationsOn=true;
  if(!a[name].friends)a[name].friends={};
  saveAccs(a);
  recalc();
  const offSec=Math.min((ts()-(S.lastSeen||ts()))/1000,3600);
  if(offSec>60&&S.auto>0){
    const gain=S.auto*offSec*0.5;
    S.balance+=gain;S.clicks+=gain;
    setTimeout(()=>toast('💤 Офлайн: +'+fmt(gain),'ach'),700);
  }
  $('login').classList.add('hide');
  $('app').classList.add('on');
  $('adminTab').style.display=isAdmin?'':'none';
  $('topName').textContent=name;
  applySkin();
  renderTab('upgrades');renderTab('skins');renderTab('sounds');renderTab('ach');
  renderTab('prestige');renderTab('promo');renderTab('friends');renderTab('games');
  renderTab('settings');
  updateUI();spawnGolden();checkAch();saveState();
}
function logout(){
  saveState();curUser=null;isAdmin=false;setCur(null);S=defState();
  $('login').classList.remove('hide');$('app').classList.remove('on');
  $('adminTab').style.display='none';
  closeAllModals();renderSaved();
  $('loginName').value='';$('loginPass').value='';$('loginErr').textContent='';
  clearTimeout(goldenT);
}
function renderSaved(){
  const a=getAccs();const names=Object.keys(a).filter(n=>!a[n].banned);
  if(!names.length){$('savedWrap').classList.add('hide');return;}
  $('savedWrap').classList.remove('hide');
  $('savedList').innerHTML=names.map(n=>{
    const adm=a[n].isAdmin,cl=Math.floor((a[n].state&&a[n].state.clicks)||0),ss=hasSess(n);
    return `<div class="saved-row">
      <button class="saved-btn" data-name="${esc(n)}"><span>${adm?'👑 ':''}${esc(n)}</span><span style="opacity:.5;font-size:9px">${fmt(cl)}${ss?' 🔓':''}</span></button>
      <button class="del-btn" data-del="${esc(n)}">✕</button>
    </div>`;
  }).join('');
  $('savedList').querySelectorAll('[data-name]').forEach(b=>{
    b.onclick=()=>{const n=b.dataset.name;
      if(hasSess(n))enterGame(n);
      else{$('loginName').value=n;$('loginPass').value='';$('loginPass').focus();}};
  });
  $('savedList').querySelectorAll('[data-del]').forEach(b=>{
    b.onclick=e=>{e.stopPropagation();
      if(!confirm('Убрать?'))return;
      dropSess(b.dataset.del);renderSaved();};
  });
}

// ============= CLICK =============
const clickBtn=$('clickBtn'),clickArea=$('clickArea');
function doClick(e){
  if(!curUser)return;
  if(raceState&&raceState.active){
    raceState.clicks++;
    const el=$('raceCounter');if(el)el.textContent=raceState.clicks;
    ps(S.activeSound);return;
  }
  const t=ts();
  if(t-lastClick<400)combo++;else combo=1;
  lastClick=t;
  const cb=1+Math.min(combo,50)*0.02*S.comboMult;
  clearTimeout(comboT);
  comboT=setTimeout(()=>{combo=0;$('combo').classList.remove('on');},800);
  if(combo>=3){$('combo').classList.add('on');$('comboVal').textContent='×'+cb.toFixed(2);}
  let gain=S.power*cb;let crit=false;
  if(Math.random()<S.critChance){gain*=S.critPower;crit=true;S.critCount++;}
  S.clicks+=gain;S.balance+=gain;
  const rect=clickArea.getBoundingClientRect();
  let cx,cy;
  if(e&&e.clientX!==undefined){cx=e.clientX-rect.left;cy=e.clientY-rect.top;}
  else{cx=rect.width/2;cy=rect.height/2;}
  const fn=document.createElement('div');
  fn.className='fn'+(crit?' crit':'');
  fn.textContent=(crit?'⚡+':'+')+fmt(gain);
  fn.style.left=cx+'px';fn.style.top=cy+'px';
  clickArea.appendChild(fn);
  setTimeout(()=>fn.remove(),1200);
  if(S.animationsOn){
    const colors=crit?['#fbbf24','#f59e0b']:['#fef3c7','#fbbf24'];
    const cnt=crit?10:5;
    for(let i=0;i<cnt;i++){
      const p=document.createElement('div');p.className='pt';
      const ang=Math.random()*Math.PI*2,d=40+Math.random()*80,sz=4+Math.random()*5;
      p.style.setProperty('--dx',Math.cos(ang)*d+'px');
      p.style.setProperty('--dy',Math.sin(ang)*d+'px');
      p.style.left=cx+'px';p.style.top=cy+'px';
      p.style.width=sz+'px';p.style.height=sz+'px';
      const c=colors[Math.floor(Math.random()*colors.length)];
      p.style.background=c;p.style.boxShadow='0 0 12px '+c;
      clickArea.appendChild(p);setTimeout(()=>p.remove(),1100);
    }
  }
  ps(S.activeSound);updateUI();
}
