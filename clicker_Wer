// ============= HELPERS =============
const $=id=>document.getElementById(id);
function hp(s){let h=5381;for(let i=0;i<s.length;i++)h=((h<<5)+h)+s.charCodeAt(i)|0;return Math.abs(h).toString(36);}
function fmt(n){n=Math.floor(n);
  if(n>=1e15)return(n/1e15).toFixed(2)+'Q';
  if(n>=1e12)return(n/1e12).toFixed(2)+'T';
  if(n>=1e9)return(n/1e9).toFixed(2)+'B';
  if(n>=1e6)return(n/1e6).toFixed(2)+'M';
  if(n>=1e3)return(n/1e3).toFixed(1)+'K';
  return n.toString();}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);}
function gid(){return 'u_'+Math.random().toString(36).slice(2,10)+Date.now().toString(36).slice(-4);}
function b64e(o){try{return btoa(unescape(encodeURIComponent(JSON.stringify(o))));}catch(e){return '';}}
function b64d(s){try{return JSON.parse(decodeURIComponent(escape(atob(s))));}catch(e){return null;}}
function ts(){return Date.now();}

// ============= STORAGE =============
function getAccs(){try{return JSON.parse(localStorage.getItem(ACC_KEY)||'{}');}catch(e){return {};}}
function saveAccs(a){try{localStorage.setItem(ACC_KEY,JSON.stringify(a));}catch(e){}}
function getSess(){try{return JSON.parse(localStorage.getItem(SESS_KEY)||'{}');}catch(e){return {};}}
function saveSess(s){try{localStorage.setItem(SESS_KEY,JSON.stringify(s));}catch(e){}}
function getCur(){try{return localStorage.getItem(CUR_KEY);}catch(e){return null;}}
function setCur(n){try{if(n)localStorage.setItem(CUR_KEY,n);else localStorage.removeItem(CUR_KEY);}catch(e){}}

function ensureAdmin(){
  const a=getAccs();
  if(!a[ADMIN_NAME]){
    a[ADMIN_NAME]={id:gid(),pass:hp(ADMIN_PASS),state:defState(),friends:{},isAdmin:true,created:ts()};
    saveAccs(a);
  }else{
    if(!a[ADMIN_NAME].isAdmin){a[ADMIN_NAME].isAdmin=true;saveAccs(a);}
    if(!a[ADMIN_NAME].id){a[ADMIN_NAME].id=gid();saveAccs(a);}
    if(!a[ADMIN_NAME].friends){a[ADMIN_NAME].friends={};saveAccs(a);}
  }
}
function saveState(){
  if(!curUser)return;
  const a=getAccs();
  if(!a[curUser])return;
  S.lastSeen=ts();
  a[curUser].state=S;
  saveAccs(a);
}
function makeSess(n){const s=getSess();s[n]={id:gid(),saved:ts()};saveSess(s);}
function hasSess(n){return !!getSess()[n];}
function dropSess(n){const s=getSess();delete s[n];saveSess(s);}

// ============= STATE =============
function defState(){
  return {clicks:0,balance:0,upgrades:{},ownedSkins:['default'],activeSkin:'default',
    ownedSounds:['boing'],activeSound:'boing',usedPromos:[],promoCps:0,
    achievements:{},prestigeLevel:0,critCount:0,goldenCount:0,gamesPlayed:0,gamesWon:0,
    lastSeen:ts(),power:1,auto:0,critChance:0.1,critPower:5,comboMult:1.0,
    messages:[],soundOn:true,animationsOn:true};
}
let S=defState();
let curUser=null;
let isAdmin=false;
let currentTab='upgrades';
let combo=0,lastClick=0,comboT=null;
let goldenT=null;
let curGame=null;
let raceState=null;

// ============= COMPUTE =============
function recalc(){
  let p=1,a=0,cc=0.1,cp=5,cm=1.0;
  for(const u of UPGRADES){
    const n=S.upgrades[u.id]||0;
    if(n>0&&u.ef){
      if(u.ef.power)p+=u.ef.power*n;
      if(u.ef.auto)a+=u.ef.auto*n;
      if(u.ef.critc)cc+=u.ef.critc*n;
      if(u.ef.critp)cp+=u.ef.critp*n;
      if(u.ef.combom)cm+=u.ef.combom*n;
    }
  }
  let m=1;
  for(const u of UPGRADES){
    if(u.ef&&u.ef.mult){
      const n=S.upgrades[u.id]||0;
      m*=Math.pow(u.ef.mult,n);
    }
  }
  const sk=SKINS.find(x=>x.id===S.activeSkin)||SKINS[0];
  const pm=1+S.prestigeLevel*0.5;
  S.power=p*m*sk.b*pm;
  S.auto=a*m*sk.b*pm+(S.promoCps||0);
  S.critChance=Math.min(0.75,cc);
  S.critPower=cp;
  S.comboMult=cm;
}
function ucost(u){return Math.floor(u.bc*Math.pow(u.g,S.upgrades[u.id]||0));}

// ============= AUDIO =============
let actx=null;
function ia(){if(!actx){try{actx=new(window.AudioContext||window.webkitAudioContext)();}catch(e){}}
  if(actx&&actx.state==='suspended')actx.resume();}
function bp(f,d,t,v){if(!S.soundOn)return;ia();if(!actx)return;
  try{const o=actx.createOscillator(),g=actx.createGain();o.type=t||'sine';o.frequency.value=f;
    g.gain.setValueAtTime(v||0.04,actx.currentTime);
    g.gain.exponentialRampToValueAtTime(0.001,actx.currentTime+d);
    o.connect(g).connect(actx.destination);o.start();o.stop(actx.currentTime+d);}catch(e){}}
const SFX={
  boing(c,n){const o=c.createOscillator();o.type='square';const f=400+Math.random()*300;
    o.frequency.setValueAtTime(f,n);
    o.frequency.exponentialRampToValueAtTime(f*1.6,n+0.05);
    o.frequency.exponentialRampToValueAtTime(f*0.7,n+0.15);
    const g=c.createGain();g.gain.setValueAtTime(0.13,n);
    g.gain.exponentialRampToValueAtTime(0.001,n+0.18);
    o.connect(g).connect(c.destination);o.start(n);o.stop(n+0.18);},
  coin(c,n){[988,1319].forEach((f,i)=>{const o=c.createOscillator();o.type='square';o.frequency.value=f;
    const g=c.createGain();g.gain.setValueAtTime(0,n+i*0.06);
    g.gain.linearRampToValueAtTime(0.1,n+i*0.06+0.005);
    g.gain.exponentialRampToValueAtTime(0.001,n+i*0.06+0.16);
    o.connect(g).connect(c.destination);o.start(n+i*0.06);o.stop(n+i*0.06+0.17);});},
  laser(c,n){const o=c.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(2200,n);
    o.frequency.exponentialRampToValueAtTime(180,n+0.14);
    const g=c.createGain();g.gain.setValueAtTime(0.09,n);
    g.gain.exponentialRampToValueAtTime(0.001,n+0.16);
    o.connect(g).connect(c.destination);o.start(n);o.stop(n+0.16);},
  bell(c,n){[880,1108,1320].forEach((f,i)=>{const o=c.createOscillator();o.type='sine';o.frequency.value=f;
    const g=c.createGain();g.gain.setValueAtTime(0,n+i*0.03);
    g.gain.linearRampToValueAtTime(0.12,n+i*0.03+0.01);
    g.gain.exponentialRampToValueAtTime(0.001,n+i*0.03+0.4);
    o.connect(g).connect(c.destination);o.start(n+i*0.03);o.stop(n+i*0.03+0.4);});},
  zap(c,n){const o=c.createOscillator();o.type='sawtooth';o.frequency.setValueAtTime(400,n);
    o.frequency.exponentialRampToValueAtTime(3000,n+0.08);
    o.frequency.exponentialRampToValueAtTime(200,n+0.18);
    const g=c.createGain();g.gain.setValueAtTime(0.12,n);
    g.gain.exponentialRampToValueAtTime(0.001,n+0.2);
    o.connect(g).connect(c.destination);o.start(n);o.stop(n+0.2);}
};
function ps(id){if(!S.soundOn)return;ia();if(!actx)return;
  try{(SFX[id]||SFX.boing)(actx,actx.currentTime);}catch(e){}}
function sBuy(){if(!S.soundOn)return;ia();if(!actx)return;
  [523,659,784,1047].forEach((f,i)=>{const o=actx.createOscillator();o.type='sine';o.frequency.value=f;
    const g=actx.createGain();g.gain.setValueAtTime(0,actx.currentTime+i*0.06);
    g.gain.linearRampToValueAtTime(0.09,actx.currentTime+i*0.06+0.01);
    g.gain.exponentialRampToValueAtTime(0.001,actx.currentTime+i*0.06+0.15);
    o.connect(g).connect(actx.destination);o.start(actx.currentTime+i*0.06);o.stop(actx.currentTime+i*0.06+0.2);});}
function sErr(){bp(200,0.1,'sawtooth',0.05);}
function sAch(){if(!S.soundOn)return;ia();if(!actx)return;
  [523,659,784,1047,1319,1568].forEach((f,i)=>{
    setTimeout(()=>{if(!actx)return;try{const o=actx.createOscillator();o.type='triangle';o.frequency.value=f;
      const g=actx.createGain();g.gain.setValueAtTime(0.08,actx.currentTime);
      g.gain.exponentialRampToValueAtTime(0.001,actx.currentTime+0.3);
      o.connect(g).connect(actx.destination);o.start();o.stop(actx.currentTime+0.3);}catch(e){}},i*60);});}

// ============= TOAST =============
let toastT=null;
function toast(txt,type){
  const el=$('toast');if(!el)return;
  el.textContent=txt;el.className='on'+(type?' '+type:'');
  clearTimeout(toastT);toastT=setTimeout(()=>el.className='',2400);
}

// ============= LOGIN =============
let loginMode='login';
document.querySelectorAll('.tabs2 button').forEach(b=>{
  b.onclick=()=>{
    document.querySelectorAll('.tabs2 button').forEach(x=>x.classList.remove('active'));
