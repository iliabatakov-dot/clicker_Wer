// ============= ADMIN =============
function renderAdmin(){
  if(!isAdmin)return;
  const a=getAccs();
  const entries=Object.entries(a);
  let h=`<div class="st">👑 Админ · ${entries.length} аккаунтов</div>`;
  h+=`<button class="ab gold" id="changePassBtn" style="margin-bottom:8px">🔑 Сменить пароль</button>`;
  h+=`<div class="pr" style="margin-bottom:8px">
    <input id="admName" placeholder="Имя" maxlength="20">
    <input id="admAmt" type="number" placeholder="Клики" value="1000" style="max-width:70px">
    <button id="admAddBtn">+</button>
  </div>`;
  for(const[name,data]of entries){
    const clicks=Math.floor((data.state&&data.state.clicks)||0);
    const banned=!!data.banned,adm=!!data.isAdmin,self=name===curUser;
    const sess=hasSess(name);
    h+=`<div class="ar ${banned?'bn':''}">
      <div class="an">
        ${adm?'👑 ':''}${esc(name)}${self?' (ты)':''}${banned?' [БАН]':''}${sess?' 🔓':''}
      </div>
      <div class="am">${fmt(clicks)} кликов</div>
      <div class="abtns">
        <button class="ax" data-adm="add" data-name="${esc(name)}" data-amt="1000">+1K</button>
        <button class="ax" data-adm="add" data-name="${esc(name)}" data-amt="100000">+100K</button>
        ${!self?`<button class="ax" data-adm="toggleAdmin" data-name="${esc(name)}">${adm?'-👑':'+👑'}</button>`:''}
        ${sess?`<button class="ax w" data-adm="forget" data-name="${esc(name)}">🔓✕</button>`:''}
        <button class="ax w" data-adm="ban" data-name="${esc(name)}">${banned?'Разбан':'Бан'}</button>
        ${!self?`<button class="ax d" data-adm="del" data-name="${esc(name)}">Удалить</button>`:''}
      </div>
    </div>`;
  }
  $('tab-admin').innerHTML=h;
  $('tab-admin').querySelectorAll('[data-adm]').forEach(b=>{
    b.onclick=()=>handleAdm(b.dataset.adm,b.dataset.name,b.dataset.amt);
  });
  const cp=$('changePassBtn');if(cp)cp.onclick=changeMyPass;
  const aa=$('admAddBtn');if(aa)aa.onclick=()=>{
    const nm=$('admName').value.trim();
    const am=$('admAmt').value;
    if(!nm){toast('Имя',true);return;}
    handleAdm('add',nm,am);
  };
}
function handleAdm(act,name,amt){
  if(!isAdmin)return;
  const a=getAccs();
  if(act==='add'){
    if(!a[name]){
      a[name]={id:gid(),pass:hp('123'),state:defState(),friends:{},created:ts()};
      saveAccs(a);
    }
    if(!a[name].state)a[name].state=defState();
    const n=parseInt(amt,10)||0;
    a[name].state.clicks=(a[name].state.clicks||0)+n;
    a[name].state.balance=(a[name].state.balance||0)+n;
    saveAccs(a);
    if(name===curUser){
      S.clicks=a[name].state.clicks;S.balance=a[name].state.balance;updateUI();
    }
    toast('✅ +'+fmt(n)+' → '+name);
    renderAdmin();return;
  }
  if(!a[name]){toast('Не найден',true);return;}
  if(act==='toggleAdmin'){
    if(name===curUser){toast('Себя нельзя',true);return;}
    a[name].isAdmin=!a[name].isAdmin;saveAccs(a);
    toast(a[name].isAdmin?'👑 '+name+' админ':name+' не админ');
    renderAdmin();return;
  }
  if(act==='forget'){dropSess(name);toast('🔒 Сессия сброшена');renderAdmin();return;}
  if(act==='ban'){
    a[name].banned=!a[name].banned;
    if(a[name].banned)dropSess(name);
    saveAccs(a);toast(a[name].banned?'🚫 Забанен':'✅ Разбанен');
    renderAdmin();return;
  }
  if(act==='del'){
    if(name===curUser){toast('Себя нельзя',true);return;}
    if(!confirm('Удалить "'+name+'"?'))return;
    delete a[name];dropSess(name);saveAccs(a);
    toast('🗑️ Удалён');renderAdmin();
  }
}
function changeMyPass(){
  if(!curUser)return;
  const a=getAccs();
  const old=prompt('Текущий пароль:');
  if(old===null)return;
  if(a[curUser].pass!==hp(old)){toast('Неверный',true);return;}
  const np=prompt('Новый пароль (мин.6):');
  if(!np||np.length<6){toast('Мин.6',true);return;}
  const np2=prompt('Повтори:');
  if(np!==np2){toast('Не совпадают',true);return;}
  a[curUser].pass=hp(np);saveAccs(a);
  dropSess(curUser);toast('🔑 Пароль изменён');
  setTimeout(()=>logout(),500);
}

