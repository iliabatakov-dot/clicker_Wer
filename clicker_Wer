      <div class="in"><div class="nm">Найди клад</div><div class="ds">1 из 16 → +10000$</div></div>
      <div class="cs">Играть</div>
    </div>
    <div class="st">⚔️ Челлендж</div>
    <div class="card" data-game="race">
      <div class="ic">⚔️</div>
      <div class="in"><div class="nm">Гонка кликов</div><div class="ds">10 секунд, кто больше</div></div>
      <div class="cs">Начать</div>
    </div>
    <div class="st">📥 Входящие коды</div>
    <textarea class="fin" id="incomingCode" placeholder="MSG2| GIFT2| RACE2|"></textarea>
    <button class="ab" id="parseCodeBtn">✓ Активировать</button>
    <div class="st">💬 Сообщения</div>
    <button class="ab purple" id="showMsgsBtn">📬 Открыть (${(S.messages||[]).length})</button>
  `;
  document.querySelectorAll('[data-game]').forEach(c=>{
    c.onclick=()=>{
      const g=c.dataset.game;
      if(g==='guess')startGuess();
      else if(g==='treasure')startTreasure();
      else if(g==='race')startRaceChallenge();
    };
  });
  $('showMsgsBtn').onclick=()=>showMessages();
  $('parseCodeBtn').onclick=()=>{
    const code=$('incomingCode').value.trim();
    if(!code){toast('Вставь код',true);return;}
    const acc=getAccs()[curUser];
    if(code.startsWith('MSG2|')){
      const d=b64d(code.slice(5));
      if(!d||!d.f||!d.m){sErr();toast('❌ Неверный',true);return;}
      if(d.ti!==acc.id){sErr();toast('❌ Не тебе',true);return;}
      S.messages=S.messages||[];
      S.messages.push({from:d.f,to:curUser,text:d.m,ts:d.t||ts(),own:false});
      saveState();toast('✉️ '+d.f+': '+d.m.slice(0,20));
      showMessages();checkAch();$('incomingCode').value='';
    }else if(code.startsWith('GIFT2|')){
      const d=b64d(code.slice(6));
      if(!d||!d.f||!d.a){sErr();toast('❌ Неверный',true);return;}
      if(d.ti!==acc.id){sErr();toast('❌ Не тебе',true);return;}
      S.balance+=d.a;S.clicks+=d.a;
      saveState();updateUI();
      toast('🎁 '+d.f+' подарил '+fmt(d.a)+'!','ach');sAch();
      $('incomingCode').value='';checkAch();
    }else if(code.startsWith('RACE2|')){
      const d=b64d(code.slice(6));
      if(!d||!d.f||d.s===undefined){sErr();toast('❌ Неверный',true);return;}
      playRaceFromCode(d);$('incomingCode').value='';
    }else{sErr();toast('❌ Неизвестный код',true);}
  };
}

function showMessages(){
  const msgs=S.messages||[];
  const list=msgs.slice(-30).reverse().map(m=>{
    const t=new Date(m.ts);
    const tm=String(t.getHours()).padStart(2,'0')+':'+String(t.getMinutes()).padStart(2,'0');
    return `<div class="msg ${m.own?'own':''}">
      <div class="ma">${esc(m.own?'Я → '+m.to:m.from)}<span class="mt">${tm}</span></div>
      <div>${esc(m.text)}</div>
    </div>`;
  }).join('');
  $('msgList').innerHTML=list||'<div class="empty">Сообщений нет</div>';
  $('msgModal').classList.add('on');
}

// Guess
function startGuess(){
  curGame={type:'guess',target:Math.floor(Math.random()*100)+1,tries:0,max:7,prize:5000,active:true};
  openGameModal();
}
function openGameModal(){
  if(!curGame)return;
  const g=curGame;
  if(g.type==='guess'){
    $('gameContent').innerHTML=`
      <div class="mgh">🎯 Угадай число</div>
      <div class="mgd">1-100 за ${g.max} попыток</div>
      <div class="mgi" id="gInfo">Попыток: 0/${g.max}</div>
      <input class="mgin" id="gInput" type="number" min="1" max="100" placeholder="1-100">
      <button class="ab" id="gBtn">ПРОВЕРИТЬ</button>
      <div id="gResult"></div>
    `;
    $('gameModal').classList.add('on');
    $('gInput').focus();
    $('gBtn').onclick=playGuess;
    $('gInput').onkeydown=e=>{if(e.key==='Enter')playGuess();};
  }
  if(g.type==='treasure'){
    let cells='';
    for(let i=0;i<16;i++)cells+=`<button class="mgcell" data-cell="${i}">🏺</button>`;
    $('gameContent').innerHTML=`
      <div class="mgh">💎 Найди клад</div>
      <div class="mgd">1 из 16 клеток</div>
      <div class="mgi">Награда: +10000$</div>
      <div class="mgg">${cells}</div>
      <div id="tResult"></div>
    `;
    $('gameModal').classList.add('on');
    document.querySelectorAll('[data-cell]').forEach(c=>{
      c.onclick=()=>playTreasure(parseInt(c.dataset.cell,10));
    });
  }
  if(g.type==='race'){
    $('gameContent').innerHTML=`
      <div class="mgh">⚔️ Гонка кликов</div>
      <div class="mgd">Кликай 10 секунд!</div>
      <div class="mgi" id="gInfo">0 кликов · 10с</div>
      <button class="ab" id="gBtn">НАЧАТЬ</button>
      <div id="gResult"></div>
    `;
    $('gameModal').classList.add('on');
    $('gBtn').onclick=beginRace;
  }
}
function playGuess(){
  if(!curGame||curGame.type!=='guess'||!curGame.active)return;
  const v=parseInt($('gInput').value,10);
  if(!v||v<1||v>100){toast('1-100',true);return;}
  curGame.tries++;
  const g=curGame;
  if(v===g.target){
    S.balance+=g.prize;S.clicks+=g.prize;S.gamesPlayed++;S.gamesWon++;
    saveState();updateUI();sAch();
    $('gResult').innerHTML=`<div class="mgi" style="color:#7aff9c">🎉 УГАДАЛ! +${fmt(g.prize)}</div>`;
    $('gBtn').style.display='none';$('gInput').style.display='none';
    g.active=false;
    setTimeout(()=>{$('gameModal').classList.remove('on');curGame=null;},2000);
    checkAch();return;
  }
  let msg=v<g.target?'📈 Больше':'📉 Меньше';
  $('gInfo').textContent=`Попыток: ${g.tries}/${g.max} · ${msg}`;
  $('gInput').value='';
  if(g.tries>=g.max){
    S.gamesPlayed++;saveState();
    $('gResult').innerHTML=`<div class="mgi" style="color:#ff9999">😢 Было ${g.target}</div>`;
    $('gBtn').style.display='none';$('gInput').style.display='none';
    g.active=false;
    setTimeout(()=>{$('gameModal').classList.remove('on');curGame=null;},2500);
  }
}
function startTreasure(){
  curGame={type:'treasure',winning:Math.floor(Math.random()*16),active:true};
  openGameModal();
}
function playTreasure(idx){
  if(!curGame||curGame.type!=='treasure'||!curGame.active)return;
  const g=curGame;
  const won=idx===g.winning;
  document.querySelectorAll('[data-cell]').forEach((c,i)=>{
    c.disabled=true;
    if(i===g.winning)c.textContent='💎';
    else if(i===idx)c.textContent='❌';
  });
  if(won){
    S.balance+=10000;S.clicks+=10000;S.gamesPlayed++;S.gamesWon++;
    saveState();updateUI();sAch();
    $('tResult').innerHTML=`<div class="mgi" style="color:#7aff9c">🎉 +10000$</div>`;
  }else{
    S.gamesPlayed++;saveState();
    $('tResult').innerHTML=`<div class="mgi" style="color:#ff9999">😢 Мимо</div>`;
  }
  g.active=false;
  setTimeout(()=>{$('gameModal').classList.remove('on');curGame=null;},2000);
  checkAch();
}

// Race
function startRaceChallenge(){
  curGame={type:'race',active:true};
  openGameModal();
}
function beginRace(){
  raceState={active:true,clicks:0,duration:10,startTime:ts()};
  $('gameContent').innerHTML=`
    <div class="mgh">⚔️ Гонка!</div>
    <div class="mgi">Кликов: <span id="raceCounter">0</span> · Осталось: <span id="raceTimer">10</span>с</div>
    <div class="mgd">Кликай главную кнопку</div>
  `;
  const t=setInterval(()=>{
    if(!raceState){clearInterval(t);return;}
    const left=Math.max(0,raceState.duration-(ts()-raceState.startTime)/1000);
    const el=$('raceTimer');if(el)el.textContent=Math.ceil(left);
    if(left<=0){clearInterval(t);endRace();}
  },100);
}
function endRace(){
  if(!raceState)return;
  const clicks=raceState.clicks;
  raceState.active=false;
  S.gamesPlayed++;
  const reward=clicks*100;
  S.balance+=reward;S.clicks+=reward;
  saveState();updateUI();sAch();
  const code='RACE2|'+b64e({f:curUser,fi:getAccs()[curUser].id,s:clicks,t:ts()});
  $('gameContent').innerHTML=`
    <div class="mgh">⚔️ Результат</div>
    <div class="mgi">${clicks} кликов · +${fmt(reward)}$</div>
    <div class="mgd">Отправь другу:</div>
    <textarea class="fin" id="raceCode" readonly style="font-size:8px">${code}</textarea>
    <button class="ab" id="copyRaceBtn">📋 Скопировать</button>
  `;
  $('copyRaceBtn').onclick=()=>{
    if(navigator.clipboard){
      navigator.clipboard.writeText(code).then(()=>toast('📋 Скопировано'))
        .catch(()=>prompt('Скопируй:',code));
    }else prompt('Скопируй:',code);
  };
  raceState=null;curGame=null;checkAch();
}
function playRaceFromCode(d){
  curGame={type:'race',active:true};
  raceState={active:true,clicks:0,duration:10,startTime:ts(),
    opponentScore:d.s,opponentName:d.f};
  $('gameContent').innerHTML=`
    <div class="mgh">⚔️ Гонка с ${esc(d.f)}</div>
    <div class="mgd">Он: ${d.s} кликов. Побей за 10 сек!</div>
    <div class="mgi">Твои: <span id="raceCounter">0</span> · <span id="raceTimer">10</span>с</div>
  `;
  $('gameModal').classList.add('on');
  const t=setInterval(()=>{
    if(!raceState){clearInterval(t);return;}
    const left=Math.max(0,raceState.duration-(ts()-raceState.startTime)/1000);
    const el=$('raceTimer');if(el)el.textContent=Math.ceil(left);
    if(left<=0){clearInterval(t);endRaceVs();}
  },100);
}
function endRaceVs(){
  if(!raceState)return;
  const clicks=raceState.clicks;
  const opp=raceState.opponentScore;
  const oppName=raceState.opponentName;
  raceState.active=false;
  S.gamesPlayed++;
  let msg='',reward=0;
  if(clicks>opp){msg=`🏆 ПОБЕДА! ${clicks} vs ${opp}`;reward=50000;S.gamesWon++;sAch();}
  else if(clicks===opp){msg=`🤝 Ничья ${clicks}`;reward=10000;}
  else{msg=`😢 ${clicks} vs ${opp}`;reward=5000;}
  S.balance+=reward;S.clicks+=reward;
  saveState();updateUI();
  $('gameContent').innerHTML=`
    <div class="mgh">⚔️ Итог</div>
    <div class="mgi">${msg}</div>
    <div class="mgi" style="color:#7aff9c">+${fmt(reward)}$</div>
  `;
  raceState=null;curGame=null;
  setTimeout(()=>{$('gameModal').classList.remove('on');},3000);
  checkAch();
}

